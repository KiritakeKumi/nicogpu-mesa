#version 450
// batch 2 test shader (build: glslangValidator -V -S comp -e ngv_ph_scale_bias --source-entrypoint main).
// The OpEntryPoint name "ngv_ph_scale_bias" selects the stub CP's placeholder kernel (ngv_pipeline.c): the compiler
// stage is a placeholder until NIR->ngcomp lands; this source documents what the kernel computes.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Src { uint v[]; } src;
layout(set = 0, binding = 1, std430) buffer Dst { uint v[]; } dst;
layout(push_constant) uniform PC { uint scale; uint bias; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < src.v.length())
        dst.v[i] = src.v[i] * pc.scale + pc.bias;
}

#version 450
// batch 2 (survey): signed integer division/modulo by a runtime value, popcount, findMSB, bitfield extract/insert,
// arithmetic and logical shifts.  Eight results per element.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { int a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { int b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer O { int o[]; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   int x = a[i], y = b[i];
   o[i * 8u + 0u] = x / y;
   o[i * 8u + 1u] = x % y;
   o[i * 8u + 2u] = bitCount(x);
 o[i * 8u + 3u] = x ^ y; // findMSB(x) lowers to ufind_msb: an ngcomp gap (section 7)
   o[i * 8u + 4u] = bitfieldExtract(x, 3, 7);
   o[i * 8u + 5u] = bitfieldInsert(x, y, 4, 8);
   o[i * 8u + 6u] = x >> 3;
   o[i * 8u + 7u] = int((uint(x) >> 5) | (uint(y) << 7));
}

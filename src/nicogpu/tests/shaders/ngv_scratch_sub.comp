#version 450
// checklist 3: 8/16-bit scratch accesses (u8/u16 ld/st.scratch) at odd byte offsets, plus a struct mixing
// u8/u16/uvec3.  Needs the Int8/Int16 SPIR-V capabilities; if the driver does not expose them, pipeline creation
// fails and the case is reported as a known gap (SKIP).
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Out { uint dst[]; };

struct Q { uint8_t t; uint16_t h; uvec3 v; uint8_t u; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   uint v = src[i];
   uint8_t b8[13];
   uint16_t h16[7];
   Q q[3];
   for (uint k = 0u; k < 13u; k++)
      b8[k] = uint8_t(v + k * 37u);
   for (uint k = 0u; k < 7u; k++)
      h16[k] = uint16_t(v * 3u + k);
   for (uint k = 0u; k < 3u; k++) {
      q[k].t = uint8_t(v + k);
      q[k].h = uint16_t(v * 5u + k);
      q[k].v = uvec3(v + k * 3u, v ^ k, v * k);
      q[k].u = uint8_t(v >> k);
   }
   uint j = v & 7u;
   uint k2 = (v >> 3) & 3u;
   uint m = min((v >> 6) & 3u, 2u);
   uint o = i * 4u;
   dst[o + 0u] = uint(b8[j]) | (uint(b8[j + 5u]) << 8) | (uint(h16[k2]) << 16);
   dst[o + 1u] = uint(h16[k2 + 3u]) | (uint(q[m].t) << 16) | (uint(q[m].u) << 24);
   dst[o + 2u] = uint(q[m].h) ^ q[m].v.x;
   dst[o + 3u] = q[m].v.y + q[m].v.z;
}

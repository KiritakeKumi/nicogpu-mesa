#version 450
// batch 2: SSBO add, c[i] = a[i] + b[i] for i < n (n from a push constant).
// Exercises: 3 buffer descriptors in set 0, a push constant, a divergent bound check, ld.buf/st.buf.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer C { uint c[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i < pc.n)
      c[i] = a[i] + b[i];
}

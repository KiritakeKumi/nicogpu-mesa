#version 450
// batch 2 (survey): 32-bit float ALU on a storage buffer.
// out[i] = fma(x, 0.5, sqrt(abs(x))) + floor(x) + max(x, 1.5) - min(x, -2.0)
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { float src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Out { float dst[]; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   float x = src[i];
   dst[i] = fma(x, 0.5, sqrt(abs(x))) + floor(x) + max(x, 1.5) - min(x, -2.0);
}
